MONGO_URI=mongodb://127.0.0.1:27017/socialflow
PORT=5000
APP_PASSWORD=change-this-before-use
SESSION_SECRET=generate-a-random-secret-of-at-least-32-characters
WEB_ORIGIN=http://localhost:5173
# Meta Instagram Login app credentials. Add this callback URL in your Meta app:
# http://localhost:5173/api/instagram/callback (or set INSTAGRAM_REDIRECT_URI explicitly)
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=http://localhost:5173/api/instagram/callback
# HTTPS public URL of the backend for uploaded image delivery, e.g. https://api.example.com
PUBLIC_BASE_URL=
# Optional: separate 32+ character secret for encrypted Instagram access tokens.
INSTAGRAM_TOKEN_ENCRYPTION_KEY=
# LinkedIn app credentials. LinkedIn requires an HTTPS callback URL.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=https://your-domain.example/api/linkedin/callback
# Update this if LinkedIn publishes a newer supported Posts API version.
LINKEDIN_API_VERSION=202606
